+// Accessibility tips for font-size use
+export function a11y(r) {
+  if (!r.ok) return []
+  const tips = [], L = ['px', 'rem', 'em']
+  if (L.includes(r.unit) && r.a > 0 && r.b > 0) {
+    const ratio = Math.max(r.a, r.b) / Math.min(r.a, r.b)
